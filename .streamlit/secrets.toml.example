# Streamlit Cloud → Settings → Secrets → diesen Inhalt einfügen.
# NIE diese Datei mit echten Werten committen!
# Echte Werte stehen in der lokalen .env (nicht im Repo).

# === Shared-Password fürs UI (Team-Zugriff) ===
app_password = "REPLACE_ME"

[default]
# === Supabase ===
SUPABASE_URL = "https://supabase.siller.io"
SUPABASE_SERVICE_ROLE_KEY = "REPLACE_ME"
DATABASE_URL = "postgresql://supabase_admin:REPLACE_ME@supabase.siller.io:6543/postgres"

# === LLM: DGX (Produktiv-Setup — passt zu den nomic-Embeddings in der DB) ===
DGX_BASE_URL = "https://pgxapi.siller.io/v1"
DGX_API_KEY = "REPLACE_ME"
DGX_CHAT_MODEL = "gemma"
DGX_CHAT_FALLBACKS = ""
DGX_EMBED_MODEL = "nomic-embed-text"
DGX_EMBED_DIM = 768

# === Web-Search (Multi-Hop-Fragen) ===
TAVILY_API_KEY = "REPLACE_ME"

# === hockeydata (für ingestion, optional in UI) ===
HOCKEYDATA_API_KEY = "3c5a99d835fcb70156d40cd60d03f350"
HOCKEYDATA_REFERER = "deb-online.live"

# === Falken-Web-Key (für playoff loader, optional) ===
HOCKEYDATA_FALKEN_KEY = "d9a998820290e620924a06f93928ea29"
HOCKEYDATA_FALKEN_REF = "heilbronner-falken.de"

# === Fallback-LLM via OpenRouter (nur falls DGX nicht erreichbar) ===
